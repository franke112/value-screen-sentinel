[Unit]
Description=vss -- the weekly Nordic screen: refresh EODHD fundamentals, price from Yahoo, value every active Nordic company by the method's core, rank on fv/price, ntfy the cheapest 40% (tools/nordic_screen.py; private data)
Documentation=file://%h/vss/tools/nordic_screen.py
OnFailure=vss-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/vss
EnvironmentFile=-%h/.config/vss/vss.env
# yfinance keeps a timezone cache; ProtectHome makes ~/.cache read-only
Environment=XDG_CACHE_HOME=%h/vss/data/cache
ExecStart=%h/vss/.venv/bin/python tools/nordic_screen.py --notify
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vss-nordic-screen
TimeoutStartSec=2h
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/vss/data %h/vss/reports
NoNewPrivileges=true
