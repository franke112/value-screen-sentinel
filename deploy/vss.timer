[Unit]
Description=Run vss daily at 22:30
Documentation=file://%h/vss/README.md

[Timer]
OnCalendar=*-*-* 22:30:00
AccuracySec=1min

# If the machine was asleep or off at 22:30, run at the next opportunity
# rather than skipping the day entirely.
Persistent=true

Unit=vss.service

[Install]
WantedBy=timers.target
