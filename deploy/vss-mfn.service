[Unit]
Description=vss -- fetch new Nordic reports (PDF) for the queue's names from MFN's public feed into sources/ (tools/fetch_mfn.py)
Documentation=file://%h/vss/tools/fetch_mfn.py
OnFailure=vss-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/vss
ExecStart=%h/vss/.venv/bin/python tools/fetch_mfn.py --queue --days 45
# E151: machine-read figures are confirmed by a second, independent reading
ExecStartPost=%h/vss/.venv/bin/python tools/cross_verify.py --all --apply
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vss-mfn
TimeoutStartSec=30min
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/vss/sources %h/vss/config/mfn_entities.yaml %h/vss/config/manual %h/vss/data/cross-verify
NoNewPrivileges=true
