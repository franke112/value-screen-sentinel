[Unit]
Description=vss -- the queue: every valued name against its lines; new reports read (vss/reportread.py) and re-valued (vss/outlook.py); ntfy only when the outlook changes; writes reports/ and data/ only
Documentation=file://%h/vss/vss/queue.py
OnFailure=vss-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/vss
ExecStart=%h/vss/.venv/bin/python -m vss queue
EnvironmentFile=-%h/.config/vss/vss.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vss-queue
TimeoutStartSec=60min
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/vss/data %h/vss/reports
NoNewPrivileges=true
