# venv
.venv/

# personal watchlist -- TRACKED since 2026-08-25, on the owner's decision:
# the repository is private and the position history belongs in git rather
# than only in .bak files on disk. The dated restore copies stay out --
# they are noise, not history, and git already keeps every version of the
# file itself. The glob does not match watchlist.example.yaml.
config/watchlist.yaml.*
# The mapping itself is a public fact about the exchange and is tracked;
# the backups --write leaves behind are not.
config/nordic_issuers.yaml.bak-*
# The filled manual files are tracked -- they carry the VERIFIED flags,
# which are a reading a person did and nothing can regenerate. Only the
# backups a --force write leaves behind are not. The cell maps under
# maps/ are tracked for the same reason and their backups are not, so the
# glob covers that subdirectory too rather than only the top level.
config/manual/*.yaml.bak-*
config/manual/maps/*.yaml.bak-*

# dated portfolio snapshots: point-in-time holdings, positions and P/L
snapshots/

# run artifacts: price cache, yfinance's own cache, sqlite history, reports
data/
# Note the form -- git cannot re-include a file whose parent DIRECTORY is
# excluded, so the CONTENTS are excluded and the briefings re-included,
# exactly as sources/ is handled below.
#
# E76's BRIEFINGS ARE TRACKED, and everything else here is not. A daily
# report, a SALES-RECORD or a SHADOW-BOOK is regenerated by running the
# command again; a briefing is hours of reading of documents that get
# withdrawn and replaced, and NOTHING REGENERATES IT. That is the same
# reason config/manual/*.yaml is tracked for its VERIFIED flags.
reports/*
!reports/BRIEFING-*.md

# python
__pycache__/
*.py[cod]
.pytest_cache/

# local scratch space
scratch/

# The documents are large and re-downloadable; the MANIFEST is the
# provenance record and is tracked. Note the form: git cannot re-include
# a file whose parent DIRECTORY is excluded, so the contents are excluded
# rather than the directory.
sources/*
!sources/manifest.json
handoff*.txt
*-valuation.xlsx
*-scoring-evidence.md
*-runs.txt

# Cloudflare Tunnel (deploy/TUNNEL-NOTES.md): the zone-level login
# certificate and the tunnel credential/config never enter the repo.
*cert.pem
deploy/*.json
deploy/cloudflared-config.yml

# The decision playbook (docs/manual/playbook.md): generated by
# tools/build_playbook.py from the repo's own sources; the generator, its
# templates and its tests are tracked, the output is not.
docs/playbook/

# inkorg / utkorg / arkiv / konto (2026-10-05) -- only their READMEs are tracked.
# konto/ holds broker statements: private, never committed.
inkorg/*
!inkorg/README.md
utkorg/*
!utkorg/README.md
arkiv/*
!arkiv/README.md
!arkiv/reference-bak/
!arkiv/evidens/
arkiv/evidens/*
!arkiv/evidens/INDEX.md
konto/*
!konto/README.md

# Vendor price data the tests read: NOT redistributed (Yahoo Finance terms).
# Fetch your own copy with tools/fetch_test_fixtures.py -- see
# tests/fixtures/VENDOR-DATA.json for exactly what each file held.
tests/fixtures/verdict-matrix/prices/*.csv
tests/fixtures/series-sanity/*.csv
tests/fixtures/ranking-acceptance/
